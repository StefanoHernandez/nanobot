{
  "expo": {
    "name": "nanobot",
    "slug": "nanobot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3f2564",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "dev.nanobot.mobile",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withNanobotWidget",
      "./plugins/withKeepAlive",
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/*",
            "*/*"
          ]
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "nanobot usa il microfono per i messaggi vocali"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "nanobot usa la fotocamera per leggere il codice di collegamento"
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
            "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f4fb",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0c0b10"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-speech-recognition"
    ],
    "scheme": "nanobot"
  }
}
